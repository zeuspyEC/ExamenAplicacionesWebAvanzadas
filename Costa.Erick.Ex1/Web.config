<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Conexión a SQL Server con el login creado en BaseDatos/Costa.Erick.Ex1.sql -->
  <connectionStrings>
    <add name="RecetasCocina"
         connectionString="Data Source=.;Initial Catalog=BDD_RecetasCocina;User ID=CostaErickEx1;Password=CostaErickEx1"
         providerName="System.Data.SqlClient" />
  </connectionStrings>
  <system.web>
    <compilation debug="true" />
    <globalization requestEncoding="utf-8" responseEncoding="utf-8" fileEncoding="utf-8" />
  </system.web>
  <system.webServer>
    <validation validateIntegratedModeConfiguration="false" />
  </system.webServer>
</configuration>
